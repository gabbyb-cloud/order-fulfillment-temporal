# Required local API credential. Replace with any non-production development value.
ORDER_API_KEY=change-me-for-local-development

# Optional demo-only failure injection. Normal runs default to 0 (disabled).
# Use values between 0 and 1, for example 0.35 for a 35% failure rate.
TRANSIENT_FAILURE_RATE=0
BUSINESS_FAILURE_RATE=0
